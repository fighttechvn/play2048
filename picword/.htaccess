# Clean URLs: serve /privacy from privacy.html, etc. (works with or without MultiViews)
Options +FollowSymLinks
<IfModule mod_rewrite.c>
  RewriteEngine On
  # /foo → /foo.html when the .html exists and /foo isn't a real file/dir
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
  # optional: redirect /foo.html → /foo (canonical, avoids duplicate URLs)
  RewriteCond %{THE_REQUEST} "\s/+([^.\s]+)\.html[\s?]" [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType font/woff2 "access plus 365 days"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
